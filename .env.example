# SiteSentry — environment template. Copy to .env and fill in.
# NEVER commit .env. The app runs fully in local-fallback mode with none of these set.
# AWS region for all services (Mumbai keeps latency low for Indian sites)
AWS_REGION=ap-south-1
# S3 bucket for raw uploads / annotated frames / incident evidence (lifecycle: 30d expire)
S3_BUCKET=sitesentry-demo-media
S3_PREFIX=
# DynamoDB table for the incident/violation event log
DDB_TABLE=sitesentry-events
# SNS topic ARN for supervisor alerts (email subscription recommended; SMS in India is costly)
SNS_TOPIC_ARN=
SUPERVISOR_EMAIL=supervisor@example.com
# Set to 1 to attempt the AWS Rekognition DetectProtectiveEquipment second opinion
# (requires credentials + network; otherwise a clearly-labeled local simulation is used)
SITENTRY_REKOGNITION=0
# Force local-fallback mode for ALL AWS clients even if credentials exist (1 = force local)
SITENTRY_AWS=off
# Optional: Bedrock incident summarization (1 = try, anything else = rule-based summary)
SITENTRY_BEDROCK=0
SITENTRY_BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0
# Flask
FLASK_PORT=5000
SITE_ID=site-a
