[Unit]
Description=SiteSentry agentic vision safety inspector
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/sitesentry
EnvironmentFile=/opt/sitesentry/.env
ExecStart=/opt/sitesentry/.venv/bin/gunicorn --workers 2 --threads 4 --bind 0.0.0.0:5000 --timeout 120 app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
